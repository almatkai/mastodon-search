{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "mastodon-search",
  "title": "Mastodon Search",
  "description": "Search for People or Hashtags on Mastodon.",
  "icon": "assets/command-icon.png",
  "author": "almatkai",
  "categories": [
    "Communication",
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search",
      "title": "Search Mastodon",
      "description": "Search Mastodon for people or hashtags.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "instance",
      "title": "Instance",
      "description": "The Mastodon instance to search.",
      "type": "textfield",
      "required": true,
      "default": "mastodon.social"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.mastodon-search",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/mastodon-search",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/mastodon-search",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
